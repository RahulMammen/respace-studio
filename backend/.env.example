# ReSpace Studio backend configuration.
# Copy to backend/.env (git-ignored) and fill in values. Never commit backend/.env.

# Google Gemini API key from https://aistudio.google.com/apikey (free tier).
# Free-tier content may be used by Google to improve products and read by human
# reviewers: only use synthetic or anonymised plans.
GEMINI_API_KEY=

# Model used for generation, editing, extraction and review. Change only to a
# currently available model ID from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Request timeout (seconds) and bounded retries for transient provider errors.
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
# Maximum proposal repair rounds after validation failures.
AI_MAX_REPAIR_ROUNDS=2

# Secret used to sign CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Allow new accounts to register from the sign-in page.
ALLOW_REGISTRATION=true

# Extra allowed origins (comma-separated) for development tools. The app's own
# origin is always allowed. Example: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
